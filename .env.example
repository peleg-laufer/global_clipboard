# Copy to src/.env for local overrides. Every setting has a working default in
# src/constants.py, so an empty file is fine. Real environment variables win
# over this file, which is how docker-compose passes these in.

# Host Mongo. Inside a compose network this becomes the service name,
# e.g. mongodb://mongo:27017/
CONNECTION_STRING=mongodb://localhost:27017/
DB_NAME=clipboard_db

# Where uploaded files are stored. In a container this must match the path the
# files volume is mounted at.
FILES_PATH=/data/files

LOG_LEVEL=DEBUG
API_LOG_FILE_PATH=api_log.log
DB_LOG_FILE_PATH=db_log.log
